    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": "Packages/LittleOrbitKit",
    },
  ],
  "files": [
    { "kind": "folder", "path": "Apps/iOS", "target-membership": [ "LittleOrbit iOS" ] },
    { "kind": "folder", "path": "Apps/macOS", "target-membership": [ "LittleOrbit macOS" ] },
    { "kind": "folder", "path": "Apps/watchOS", "target-membership": [ "LittleOrbit watchOS" ] },
    { "kind": "folder", "path": "Apps/Shared", "target-membership": [ "LittleOrbit iOS", "LittleOrbit macOS", "LittleOrbit watchOS" ] },
    {
      "kind": "group",
      "path": "Config",
      "children": [
        {
          "path": "InfoPlist.xcstrings",
          "target-membership": [
            "LittleOrbit iOS/resources",
            "LittleOrbit macOS/resources",
          ],
        },
        { "path": "LittleOrbit-Info.plist" },
        { "path": "Shared.xcconfig" },
        { "path": "Signing.xcconfig" },
        { "path": "Signing.local.xcconfig.example" },
        { "path": "iOS.xcconfig" },
        { "path": "macOS.xcconfig" },
        { "path": "watchOS.xcconfig" },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/LittleOrbit.app", "id": "7C2E9B1A4D6F48C2E9B1A4D6", "index": false },
        { "path": "<PRODUCTS>/LittleOrbitMac.app", "id": "7C2E9B1A4D6F48C2E9B1A4D7", "index": false },
        { "path": "<PRODUCTS>/LittleOrbitWatch.app", "id": "7C2E9B1A4D6F48C2E9B1A4D8", "index": false, "target-membership": [ "LittleOrbit iOS/copy/Embed Watch Content" ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "LittleOrbit iOS",
      "id": "4F8A1C0E2B7D49A1C0E2B7D4",
      "product": "Products/LittleOrbit.app",
      "product-type": "application",
      "specialized-configurations": [
        { "name": "Debug", "file": "Config/iOS.xcconfig" },
        { "name": "Release", "file": "Config/iOS.xcconfig" },
      ],
      "dependencies": [
        { "kind": "package", "package": "LittleOrbitKit", "product-name": "LittleOrbitCore" },
        { "kind": "package", "package": "LittleOrbitKit", "product-name": "LittleOrbitDomain" },
