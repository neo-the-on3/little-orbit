#include "Shared.xcconfig"

// macOS app. Deployment target 27.0. Bundle ID app.littleorbit.macos by default:
// LITTLEORBIT_BUNDLE_ID_BASE and LITTLEORBIT_BUNDLE_ID_SUFFIX from Shared.xcconfig or Config/Local.xcconfig.
// App Sandbox is not enabled. Add an entitlements file with that capability later.

PRODUCT_NAME = LittleOrbitMac
PRODUCT_BUNDLE_IDENTIFIER = $(LITTLEORBIT_BUNDLE_ID_BASE).macos$(LITTLEORBIT_BUNDLE_ID_SUFFIX)
INFOPLIST_KEY_CFBundleDisplayName = Little Orbit
// The exported .littleorbit-backup type (D195a.1, L19) and LittleOrbitAppGroupIdentifier, from
// LITTLEORBIT_APP_GROUP_IDENTIFIER in Shared.xcconfig (#52). Generated keys are merged into it. No document types:
// opening a backup from Files or Finder is the follow-up to #40 (D197.3, L39).
INFOPLIST_FILE = Config/LittleOrbit-Info.plist
SDKROOT = macosx
MACOSX_DEPLOYMENT_TARGET = 27.0
ENABLE_HARDENED_RUNTIME = YES
COMBINE_HIDPI_IMAGES = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks

// Draft for Kiran (#52): the App Group entitlement isn't enabled. LITTLEORBIT_ENTITLEMENTS (Shared.xcconfig) is
// empty, so no entitlements are signed in and the store uses the Application Support fallback. Turning it on is
// setting that variable, together with the simulator signing change and App Group registration that need
// Kiran. A builder can turn it on or off for their own builds in Config/Local.xcconfig (see
// Config/Local.xcconfig.example and the README).
CODE_SIGN_ENTITLEMENTS = $(LITTLEORBIT_ENTITLEMENTS)
