// Shared build settings for the Little Orbit apps.
//
// Deployment targets match the SDKs that ship with Xcode 27.2.
// Platform xcconfig files set the per-target values:
//
//   Target              SDK        Deployment   Bundle ID                  Product
//   LittleOrbit iOS     iphoneos   27.0         app.littleorbit.ios        LittleOrbit.app
//   LittleOrbit macOS   macosx     27.0         app.littleorbit.macos      LittleOrbitMac.app
//   LittleOrbit watchOS watchos    27.0         app.littleorbit.watchos    LittleOrbitWatch.app
//
// Display name on every platform: Little Orbit
// The watchOS app is standalone. It is not embedded in the iOS app.
//
// Signing is automatic. The committed Team ID is empty.
// Local team and optional bundle ID suffix: Config/Signing.local.xcconfig
// (see Config/Signing.local.xcconfig.example).

MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1
GENERATE_INFOPLIST_FILE = YES
ENABLE_PREVIEWS = YES
SWIFT_EMIT_LOC_STRINGS = YES

// App Group for the shared on-device store (#52, D34.1). The iOS and macOS apps write it into Info.plist
// (Config/LittleOrbit-Info.plist) and, once enabled, into their entitlements (Config/LittleOrbit.entitlements).
// This is the only place the ID is set. If team signing needs the team-prefixed form on macOS, override it
// in macOS.xcconfig. The watchOS app keeps its own store (#48) and doesn't use it.
//
// The store uses the group container only when the app is signed with this entitlement. Until then it falls
// back to Application Support/<bundle id> (StoreLocation in LittleOrbitPersistence).
LITTLEORBIT_APP_GROUP_IDENTIFIER = group.app.littleorbit
