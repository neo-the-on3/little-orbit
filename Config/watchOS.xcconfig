#include "Shared.xcconfig"

// Standalone watchOS app. Deployment target 27.0. Bundle ID
// app.littleorbit.watchos by default: LITTLEORBIT_BUNDLE_ID_BASE and
// LITTLEORBIT_BUNDLE_ID_SUFFIX from Shared.xcconfig or Config/Local.xcconfig.
// Not embedded in the iOS app.
//
// The generated Info.plist marks the app Watch-only (WKWatchOnly) because it
// has no iOS companion. WKRunsIndependentlyOfCompanionApp is for watch apps
// that do have a companion, and simctl install rejects an app that sets both.

PRODUCT_NAME = LittleOrbitWatch
PRODUCT_BUNDLE_IDENTIFIER = $(LITTLEORBIT_BUNDLE_ID_BASE).watchos$(LITTLEORBIT_BUNDLE_ID_SUFFIX)
INFOPLIST_KEY_CFBundleDisplayName = Little Orbit
SDKROOT = watchos
WATCHOS_DEPLOYMENT_TARGET = 27.0
TARGETED_DEVICE_FAMILY = 4
INFOPLIST_KEY_WKApplication = YES
INFOPLIST_KEY_WKWatchOnly = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
