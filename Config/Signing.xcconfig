// Automatic signing for Little Orbit.
//
// This file must not contain certificates, private keys, or provisioning
// profiles. Do not commit those. Create and download them only in Xcode
// or the Apple Developer portal, on a Mac, and keep them out of git.
//
// Kiran: set LITTLEORBIT_DEVELOPMENT_TEAM to the 10-character Apple
// Developer Team ID (developer.apple.com > Membership details).
//
// The value is intentionally empty. Device and distribution builds need
// the real Team ID. Simulator builds skip signing, and the Mac app is
// ad-hoc signed ("Sign to Run Locally"), so both still launch before the
// Team ID is filled in.
//
// After the Team ID is set, remove the macosx CODE_SIGN_IDENTITY line so
// automatic signing can use the team for Developer ID or App Store builds.

LITTLEORBIT_DEVELOPMENT_TEAM =
DEVELOPMENT_TEAM = $(LITTLEORBIT_DEVELOPMENT_TEAM)
CODE_SIGN_STYLE = Automatic

CODE_SIGNING_ALLOWED[sdk=iphonesimulator*] = NO
CODE_SIGNING_ALLOWED[sdk=watchsimulator*] = NO
CODE_SIGN_IDENTITY[sdk=macosx*] = -
