                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%1$@ from %2$@ to %3$@": {
      "comment": "An Undo or Redo name, delete toast or undo notice, with where it happened: a transfer's two accounts. %1$@ is the action, such as \"Edit Transfer\"; %2$@ and %3$@ are the From and To account names.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ from %2$@ to %3$@"
