{
  "sourceLanguage": "en",
  "strings": {
    "%1$@ from %2$@ to %3$@": {
      "comment": "An Undo or Redo name, delete toast or undo notice, with where it happened: a transfer's two accounts. %1$@ is the action, such as \"Edit Transfer\"; %2$@ and %3$@ are the From and To account names.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ from %2$@ to %3$@"
          }
        }
      }
    },
    "%1$@ in %2$@": {
      "comment": "An Undo or Redo name, delete toast or undo notice, with where it happened: one account. %1$@ is the action, such as \"Delete Transaction\"; %2$@ is the account name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ in %2$@"
          }
        }
      }
    },
    "%1$@ in %2$lld Accounts": {
      "comment": "An Undo or Redo name, delete toast or undo notice, with where it happened: several accounts. %1$@ is the action, such as \"Delete 5 Transactions\"; %2$lld is the number of accounts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ in %#@accounts@"
          },
          "substitutions": {
            "accounts": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg Account"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg Accounts"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%@ was changed in another window. Nothing was changed.": {
      "comment": "Alert message: Undo or Redo of a record another window changed since. %@ is the transaction's payee or description, or an account name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ was changed in another window. Nothing was changed."
          }
        }
      }
    },
    "%@ was deleted in another window. Nothing was changed.": {
      "comment": "Alert message: Undo or Redo of a record or account another window deleted. %@ is the transaction's payee or description, or the account name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ was deleted in another window. Nothing was changed."
          }
        }
      }
    },
    "%lld of these transactions were changed or deleted in another window. Nothing was changed.": {
      "comment": "Alert message: a bulk Undo or Redo where more than one transaction was changed or deleted in another window, so nothing was changed. %lld is how many.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld of these transactions was changed or deleted in another window. Nothing was changed."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld of these transactions were changed or deleted in another window. Nothing was changed."
                }
              }
            }
          }
        }
      }
    },
