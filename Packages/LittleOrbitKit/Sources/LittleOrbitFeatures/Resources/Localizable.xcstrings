      "comment": "Alert title: a Redo that can't run because a record it changes was changed or deleted after the step was recorded. %@ is the Redo name, such as \"Delete Transaction\". Don't name a cause: the same check catches a change from anywhere.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t Redo %@"
          }
        }
      }
    },
    "Can’t tell which row is the other half of this transfer": {
      "comment": "CSV import row issue (D330.2): two or more rows are equally close to be this transfer’s other half and would make different transfers, so none of them imports.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t tell which row is the other half of this transfer"
          }
        }
      }
    },
    "Can’t Undo %@": {
      "comment": "Alert title: an Undo that can't run because a record it changes was changed or deleted after the step was recorded. %@ is the Undo name, such as \"Edit Transaction\". Don't name a cause: the same check catches a change from anywhere.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t Undo %@"
          }
        }
      }
    },
    "Can’t Undo Import": {
      "comment": "CSV import: alert title when Undo Import is refused because something changed since.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t Undo Import"
          }
        }
      }
    },
