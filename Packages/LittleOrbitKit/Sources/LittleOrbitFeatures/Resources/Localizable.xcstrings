{
  "sourceLanguage": "en",
  "strings": {
    "%1$@ %2$@": {
      "comment": "Two sentences in a row: %1$@ is the first, %2$@ the second (backup footnote and Keep footer, or newer-format note and its detail).",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@"
          }
        }
      }
    },
    "%1$@ (%2$@)": {
      "comment": "Refund sheet Account picker: an account in another currency than the expense. %1$@ is its name, %2$@ its currency code, e.g. “Travel Card (USD)”.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@)"
          }
        }
      }
    },
    "%1$@ from %2$@ to %3$@": {
      "comment": "An Undo or Redo name, delete toast or undo notice, with where it happened: a transfer's two accounts. %1$@ is the action, such as \"Edit Transfer\"; %2$@ and %3$@ are the From and To account names.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ from %2$@ to %3$@"
          }
        }
      }
    },
    "%1$@ in %2$@": {
      "comment": "An Undo or Redo name, delete toast or undo notice, with where it happened: one account. %1$@ is the action, such as \"Delete Transaction\"; %2$@ is the account name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ in %2$@"
          }
        }
      }
    },
    "%1$@ in %2$lld Accounts": {
      "comment": "An Undo or Redo name, delete toast or undo notice, with where it happened: several accounts. %1$@ is the action, such as \"Delete 5 Transactions\"; %2$lld is the number of accounts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ in %#@accounts@"
          },
          "substitutions": {
            "accounts": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg Account"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg Accounts"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%1$@ is already the To account of %2$lld selected transfers. Pick a different account to save.": {
      "comment": "Bulk edit: Apply saved nothing because the chosen account is the To account of selected transfers (D223.3). %1$@ is the chosen account; %2$lld is how many selected transfers go to it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is already the To account of %#@transfers@. Pick a different account to save."
          },
          "substitutions": {
            "transfers": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "a selected transfer"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg selected transfers"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%1$@ of %2$@": {
      "comment": "Refund sheet, iOS Refundable row: %1$@ is what can still be refunded, %2$@ the expense’s amount, e.g. “₹700.00 of ₹1,000.00”.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ of %2$@"
          }
        }
      }
    },
    "%1$@ · %2$@": {
      "comment": "Two values with a middle dot: a backup’s account count (%1$@) and transaction count (%2$@), or the refund sheet’s Refund of row, the expense’s payee or description (%1$@) and its date (%2$@).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        }
      }
    },
    "%1$@, %2$@": {
      "comment": "Two parts joined with a comma: a backup's day and time (%1$@ the day, %2$@ the time), or its account and transaction counts as VoiceOver reads them.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@"
          }
        }
      }
    },
    "%1$@, under %2$@": {
      "comment": "VoiceOver value of the category picker for a subcategory, so its parent is heard: \"Groceries, under Food\". %1$@ is the subcategory, %2$@ its parent category.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, under %2$@"
          }
        }
      }
    },
    "%3$lld selected transactions are in %1$@, so they can’t move to %2$@. Pick an account in %1$@ to save.": {
      "comment": "Bulk edit: Apply saved nothing because the chosen account is in another currency (D226.4). %1$@ is the selected rows’ currency code, such as INR; %2$@ is the chosen account; %3$lld is how many selected rows are in that currency.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@subject@ in %1$@, so %#@pronoun@ can’t move to %2$@. Pick an account in %1$@ to save."
          },
          "substitutions": {
            "subject": {
              "argNum": 3,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "A selected transaction is"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg selected transactions are"
                    }
                  }
                }
              }
            },
            "pronoun": {
              "argNum": 3,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "it"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "they"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%3$lld selected transactions aren’t in %1$@, so they can’t move to %2$@. Select transactions in one currency to change Account.": {
      "comment": "Bulk edit: Apply saved nothing because the selection mixes currencies and some rows aren’t in the chosen account’s currency (D227.2). %1$@ is the chosen account’s currency code, such as INR; %2$@ is the chosen account; %3$lld is how many selected rows aren’t in that currency.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@subject@ in %1$@, so %#@pronoun@ can’t move to %2$@. Select transactions in one currency to change Account."
          },
          "substitutions": {
            "subject": {
              "argNum": 3,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "A selected transaction isn’t"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg selected transactions aren’t"
                    }
                  }
                }
              }
            },
            "pronoun": {
              "argNum": 3,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "it"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "they"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%@ (from the expense)": {
      "comment": "macOS refund sheet Category value. %@ is the expense’s category, which a refund keeps.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (from the expense)"
          }
        }
      }
    },
    "%@ has already been refunded. A refund keeps the expense’s category and uses the same currency.": {
      "comment": "Refund sheet footnote. %@ is the amount already refunded on the expense, e.g. ₹300.00.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has already been refunded. A refund keeps the expense’s category and uses the same currency."
          }
        }
      }
    },
    "%@ has changed since then. Nothing was changed.": {
      "comment": "Alert message: an Undo or Redo that can't run because the record changed after the step was recorded, so nothing was changed. %@ is the transaction's payee or description, or an account name. Don't name a cause: the same check catches a change from anywhere.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has changed since then. Nothing was changed."
          }
        }
      }
    },
    "%@ has been deleted. Nothing was changed.": {
      "comment": "Alert message: an Undo or Redo that can't run because the record or account was deleted after the step was recorded, so nothing was changed. %@ is the transaction's payee or description, or the account name. Don't name a cause: the same check catches a change from anywhere.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has been deleted. Nothing was changed."
          }
        }
      }
    },
    "%lld Months": {
      "comment": "Monthly Backups stepper value. %lld is the number of months (1–24).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Month"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Months"
                }
              }
            }
          }
        }
      }
    },
    "%lld accounts": {
      "comment": "A backup's account count.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld account"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld accounts"
                }
              }
            }
          }
        }
      }
    },
    "%lld attachments": {
      "comment": "A backup's attachment count, in the Export summary.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld attachment"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld attachments"
                }
              }
            }
          }
        }
      }
    },
    "%lld of these transactions have changed or been deleted since then. Nothing was changed.": {
      "comment": "Alert message: a bulk Undo or Redo that can't run because more than one of its transactions changed or was deleted after the step was recorded, so nothing was changed. %lld is how many. Don't name a cause: the same check catches a change from anywhere.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld of these transactions has changed or been deleted since then. Nothing was changed."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld of these transactions have changed or been deleted since then. Nothing was changed."
                }
              }
            }
          }
        }
      }
    },
    "%lld transactions": {
      "comment": "A backup's transaction count.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld transaction"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld transactions"
                }
              }
            }
          }
        }
      }
    },
    "A refund keeps the expense’s category and uses the same currency.": {
      "comment": "Refund sheet footnote when nothing has been refunded on the expense yet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A refund keeps the expense’s category and uses the same currency."
          }
        }
      }
    },
