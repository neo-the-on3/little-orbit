    "Can't Redo %@": {
      "comment": "Alert title: a Redo that can't run because another window changed its records. %@ is the Redo name, such as \"Delete Transaction\".",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't Redo %@"
          }
        }
      }
    },
    "Can't Undo %@": {
      "comment": "Alert title: an Undo that can't run because another window changed its records. %@ is the Undo name, such as \"Edit Transaction\".",
      "extractionState": "manual",
