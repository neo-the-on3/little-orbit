      },
      "generatesSymbol": false
    },
    "category.delete.movingDeletes": {
      "comment": "Category delete alert sentence, for a category with no subcategories: %lld is how many transactions and split lines use it, which picks “it” or “them”.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@moving@"
          },
          "substitutions": {
            "moving": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Moving or leaving it uncategorised deletes the category."
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Moving or leaving them uncategorised deletes the category."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "category.delete.movingDeletesWithSubcategories": {
      "comment": "Category delete alert sentence: the first number is how many transactions and split lines use the category and its subcategories, which picks “it” or “them”; the second is how many subcategories are deleted with it.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@moving@"
          },
          "substitutions": {
            "moving": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Moving or leaving it uncategorised deletes the category and its %#@subcategories@."
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Moving or leaving them uncategorised deletes the category and its %#@subcategories@."
                    }
                  }
                }
              }
            },
            "subcategories": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "subcategory"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg subcategories"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
