{
  "sourceLanguage": "en",
  "strings": {
    "%1$@ %2$@": {
      "comment": "Two sentences in a row: %1$@ is the first, %2$@ the second (backup footnote and Keep footer, or newer-format note and its detail; the Undo Import confirmation’s sentences; or the account delete confirmation’s scheduled sentences, D288’s first, D372).",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@"
          }
        }
      }
    },
    "%1$@ (%2$lld)": {
      "comment": "The audio graph's name for a chart bar whose name another bar already has: %1$@ is the name, %2$lld its position among the bars with that name, as in “Uncategorised (2)”. Reports chart.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$lld)"
          }
        }
      }
    },
    "%1$@ are removed from lists, autocomplete and reports.": {
      "comment": "Merge Payees footnote sentence (D297.3): %1$@ is the payee merged into the one kept, or the payees joined in the system list format (“A, B, and C”); how many there are picks the form.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%1$@ is removed from lists, autocomplete and reports."
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%1$@ are removed from lists, autocomplete and reports."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%1$@ from %2$@ to %3$@": {
      "comment": "An Undo or Redo name, delete toast or undo notice, with where it happened: a transfer's two accounts. %1$@ is the action, such as \"Edit Transfer\"; %2$@ and %3$@ are the From and To account names.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ from %2$@ to %3$@"
          }
        }
      }
    },
    "%1$@ in %2$@": {
      "comment": "An Undo or Redo name, delete toast or undo notice, with where it happened: one account. %1$@ is the action, such as \"Delete Transaction\"; %2$@ is the account name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ in %2$@"
          }
        }
      }
    },
    "%1$@ in %2$lld Accounts": {
      "comment": "An Undo or Redo name, delete toast or undo notice, with where it happened: several accounts. %1$@ is the action, such as \"Delete 5 Transactions\"; %2$lld is the number of accounts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ in %#@accounts@"
          },
          "substitutions": {
            "accounts": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg Account"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg Accounts"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%1$@ keeps the most recent last-used category (%2$@).": {
      "comment": "Merge Payees footnote sentence (D291.5): %1$@ is the payee kept; %2$@ is the category a new transaction with it preselects.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ keeps the most recent last-used category (%2$@)."
          }
        }
      }
    },
    "%1$@ of spending": {
      "comment": "Spending report: the start of a category drill-down’s header, before the period and currency. %1$@ is the category’s share of the period’s spending, such as “16.9%”.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ of spending"
          }
        }
      }
    },
    "%1$@ · %2$@": {
      "comment": "Two values joined with a middle dot: a backup’s account count (%1$@) and transaction count (%2$@); in the spending drill-down’s header, the report’s period (%1$@, such as “October 2026”) and currency code (%2$@, such as “INR”), and then the category’s share (%1$@, such as “16.9% of spending”) and that period and currency (%2$@); on the CSV import Columns step, the file’s name (%1$@) and its row count (%2$@); a Scheduled row’s name, a description and its payee (“Rent · Landlord”); the iOS Scheduled row detail, built up part by part (“Monthly · Auto · Everyday Savings”); a Scheduled form category under its parent (“Home · Rent”); the Mac Scheduled Table footer (“8 scheduled · 2 overdue · double-click to open”); and the Mac Scheduled Table Status (“Due today · Notifications off”, “Automatic · Notifications off”).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        }
      }
    },
    "%1$@ · %2$@ · %3$@": {
      "comment": "Spending drill-down header's scope: %1$@ is the period, %2$@ the account part (“all accounts” or “2 of 3 accounts”), %3$@ the currency code, “October 2026 · all accounts · INR”.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@ · %3$@"
          }
        }
      }
    },
    "%1$@ · %2$@.": {
      "comment": "Apple Watch message, first sentence: %1$@ is the scheduled item’s name and %2$@ the occurrence’s due date, such as 20 Oct.",
